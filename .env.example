# ============================================================
# SPIDER-VERSE CTF — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- CTFd Core ---
SECRET_KEY=change-me-to-a-long-random-secret-key
DATABASE_URL=mysql+pymysql://ctfd:ctfd_password@db/ctfd
REDIS_URL=redis://cache:6379

# --- Database ---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=ctfd
MYSQL_USER=ctfd
MYSQL_PASSWORD=change-me-ctfd-password

# --- CTFd Admin (first-time setup only) ---
CTFD_ADMIN_EMAIL=organizer@example.com
CTFD_ADMIN_PASSWORD=change-me-admin-password

# --- CTFd Settings ---
CTFD_NAME=SPIDER-VERSE CTF
UPLOAD_FOLDER=/var/uploads
LOG_FOLDER=/var/log/CTFd
ACCESS_LOG=-
ERROR_LOG=-

# --- Event Date (ISO 8601, used by countdown on landing page) ---
EVENT_DATE=2026-11-01T09:00:00

# --- Theme ---
THEME_NAME=spider-verse
